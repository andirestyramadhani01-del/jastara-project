<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkoutContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:visibility="gone">

    <!-- Top Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/checkoutHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnCheckoutBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_nav_home"
            android:rotation="-90"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout Pesanan"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/checkoutFooter"
        app:layout_constraintTop_toBottomOf="@+id/checkoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Item Brief Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/bg_gray">
                        <ImageView
                            android:id="@+id/imgCheckoutProduct"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:src="@drawable/ic_bag"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtCheckoutProductName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tas Branded Import"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtCheckoutProductPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rp 350.000"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Form: Qty & Alamat & Catatan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Qty Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kuantitas Barang"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnQtyMinus"
                                style="?android:attr/buttonStyleSmall"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="-"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:padding="0dp"
                                android:backgroundTint="@color/brand_navy_light"
                                android:textColor="@color/brand_navy"
                                app:cornerRadius="6dp"/>

                            <TextView
                                android:id="@+id/txtQtyCount"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:textSize="14sp"/>

                            <Button
                                android:id="@+id/btnQtyPlus"
                                style="?android:attr/buttonStyleSmall"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="+"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:padding="0dp"
                                android:backgroundTint="@color/brand_navy_light"
                                android:textColor="@color/brand_navy"
                                app:cornerRadius="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Alamat Pengiriman -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Alamat Pengiriman"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCheckoutAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Masukkan alamat pengiriman lengkap..."
                            android:inputType="textMultiLine"
                            android:lines="2"
                            android:textSize="13sp"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Catatan (Opsional) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Catatan (Opsional)"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCheckoutNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contoh: Warna merah, ukuran L, dll."
                            android:inputType="text"
                            android:textSize="13sp"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Methods Selector -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Metode Pembayaran"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <RadioGroup
                        android:id="@+id/rgPaymentMethods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbCOD"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="COD (Bayar di Tempat)"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:buttonTint="@color/brand_navy"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rbFullPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Full Payment (Transfer Bank)"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:buttonTint="@color/brand_navy"/>

                        <RadioButton
                            android:id="@+id/rbDP50"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DP 50% (Bayar Setengah)"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:buttonTint="@color/brand_navy"/>

                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Phase 3: Simulated Payment Proof Uploader (for Transfer) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentProof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_navy"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txtProofTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Bukti Transfer"
                        android:textColor="@color/brand_navy"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtProofSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Transfer ke Bank BCA JASTARA: 123-456-789"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"/>

                    <!-- Action Uploader Area -->
                    <LinearLayout
                        android:id="@+id/btnTriggerUpload"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/ic_nav_home"
                        android:backgroundTint="#F1F5F9"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/imgProofIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_nav_orders"
                            android:tint="@color/brand_navy"/>

                        <TextView
                            android:id="@+id/txtProofStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Sentuh untuk Memilih &amp; Upload Gambar Bukti"
                            android:textColor="@color/brand_navy"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Format: JPG, PNG (Maks. 2MB)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- Realtime Upload Progress Bar -->
                    <LinearLayout
                        android:id="@+id/layoutUploadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtUploadPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mengunggah ke Firebase Storage: 0%"
                            android:textColor="@color/brand_navy"
                            android:textSize="11sp"/>

                        <ProgressBar
                            android:id="@+id/progressProofUpload"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:progressTint="@color/brand_navy"
                            android:progressBackgroundTint="@color/divider"
                            android:progress="0"/>
                    </LinearLayout>

                    <!-- Success Validation Message -->
                    <LinearLayout
                        android:id="@+id/layoutUploadSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/status_completed_bg"
                        android:padding="8dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_status_completed"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Bukti transfer berhasil diunggah!"
                            android:textColor="@color/status_completed"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Order Pricing Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ringkasan Pesanan"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtSummaryProductLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tas Branded Import (x1)"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/txtSummaryProductPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 350.000"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ongkos Kirim"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/txtSummaryShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 20.000"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Grand Total"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:id="@+id/txtSummaryGrandTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 370.000"
                            android:textColor="@color/brand_navy"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Confirm Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/checkoutFooter"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnConfirmCheckout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Konfirmasi &amp; Bayar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_navy"
            android:textColor="@color/white"
            app:cornerRadius="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
