<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Icon Indicator -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/brand_navy_light">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_nav_orders"
                android:tint="@color/brand_navy"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Order Brief -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtOrderListId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order ID: ORD-168482"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtOrderListProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tas Branded Import (x2)"
                android:textColor="@color/text_muted"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtOrderListTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rp 720.000"
                android:textColor="@color/brand_navy"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Status Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOrderListStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="6dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/status_pending_bg">

            <TextView
                android:id="@+id/txtOrderListStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Menunggu"
                android:textColor="@color/status_pending"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
